# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Security Secrets
JWT_SECRET="your_32_plus_character_jwt_secret_key_here"
TELEMETRY_SALT="custom-telemetry-salt-for-ip-hashing"

# Admin Authentication (Passphrase)
ADMIN_PASSPHRASE="your_secure_passphrase"
# Or Bcrypt Hash (Escape $ as \$ in Next.js .env files)
ADMIN_PASSPHRASE_HASH="\$2a\$10\$your_bcrypt_hash_here"

# Google Authenticator TOTP 2FA (Leave empty on local, set on Vercel)
AUTHENTICATOR=""

# Environment
NODE_ENV="development"


