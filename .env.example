# Database Connection (SQLite local or PostgreSQL prod)
DATABASE_URL="file:./dev.db"

# Admin Authentication Passphrase Hash (stored securely, generated via script)
ADMIN_PASSPHRASE_HASH="your_bcrypt_hashed_passphrase_here"

# Admin Plaintext Passphrase (used as fallback check if hash not set)
ADMIN_PASSPHRASE="your_secure_passphrase_here"

# JWT Secret Key for Session Tokens
JWT_SECRET="your_32_plus_character_jwt_secret_key_here"

# Environment
NODE_ENV="development"
