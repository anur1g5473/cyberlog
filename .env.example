# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Security Secrets
JWT_SECRET="your_32_plus_character_jwt_secret_key_here"

# Passphrase Bcrypt Hash (Escape $ as \$ in Next.js .env files)
ADMIN_PASSPHRASE_HASH="\$2a\$10\$your_bcrypt_hash_here"

# Environment
NODE_ENV="development"


